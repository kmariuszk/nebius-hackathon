# Copy to .env at the repo root and fill it in. harness/ and discovery/ both read it.

# --- Agents (harness/) ---------------------------------------------------------

# Nebius Token Factory: every LLM call, including the papers MCP's `rerank`. Required.
TF_API_KEY=
# TF_BASE_URL=https://api.tokenfactory.nebius.com/v1/
# Model IDs. `cd harness && uv run python -m harness.check` lists what Token Factory serves.
# SUPER_VL_MODEL=nvidia/Nemotron-3.5-Super-VL
# LIGHTNING_MODEL also names the papers MCP's clusters (cluster_papers).
# LIGHTNING_MODEL=nvidia/Nemotron-3_5-Lightning

# The papers MCP (discovery/). This is where `uv run python -m discovery` serves it.
# PAPERS_MCP_URL=http://127.0.0.1:8001/mcp
# The board service's canvas MCP, for `adk web` (under ACP the chat session provides it).
# CANVAS_MCP_URL=http://localhost:5858/api/mcp/canvas/<boardId>
# The researcher's board token; sent to both MCP servers as a bearer token.
# BOARD_TOKEN=
# Which agent a chat uses: master (default), board_assistant (the wiring agent), echo (no model, no keys),
# any harness/agents/<name>, or module:function.
# HARNESS_AGENT=master
# scripted:<path> makes every agent replay recorded turns (keyless tests).
# HARNESS_MODEL=
# Seconds one model call may take before it is retried (twice); a call Token Factory never answers would block its agent.
# MODEL_TIMEOUT=120
# Price override for the chat's cost line, USD per million input and output tokens.
# MODEL_PRICES_JSON={"nvidia/Nemotron-3.5-Super-VL": [0.3, 0.9]}

# --- Both ----------------------------------------------------------------------

# Tavily: web search in the papers MCP, and Tavily's remote MCP for agents. Required by both challenges.
TAVILY_API_KEY=
# TAVILY_MCP_URL=https://mcp.tavily.com/mcp/

# --- Papers MCP (discovery/) -----------------------------------------------------

# OpenAlex: free key from https://openalex.org/settings/api. Without it, OpenAlex search
# and the "citing" strategy are skipped (keyless requests share a tiny per-IP budget).
OPENALEX_API_KEY=
# Optional: raises PubMed's limit from 3 to 10 requests a second (https://account.ncbi.nlm.nih.gov/settings/).
NCBI_API_KEY=
# Optional: a steady Semantic Scholar rate limit (https://www.semanticscholar.org/product/api).
SEMANTIC_SCHOLAR_API_KEY=
# The `rerank` tool's default backend: super_vl (listwise, Token Factory) or rerank_vl (NVIDIA hosted).
# RERANK_BACKEND=super_vl
# 1 lets Super VL reason before a super_vl rerank: slower (about 15 s instead of 2 s on a small list).
# RERANK_THINKING=1
# NVIDIA API key from https://build.nvidia.com, for the rerank_vl backend only.
# NVIDIA_API_KEY=
# NVIDIA_BASE_URL=https://ai.api.nvidia.com/v1/
# RERANK_VL_MODEL=nvidia/llama-nemotron-rerank-vl-1b-v2
# DISCOVERY_HOST=127.0.0.1
# DISCOVERY_PORT=8001
# DISCOVERY_DB=discovery/data/papers.sqlite3
# DISCOVERY_VECTORS=discovery/data/vectors
# Embeddings for score_candidates: any OpenAI-compatible /v1/embeddings endpoint.
# Defaults to Token Factory with TF_API_KEY; changing the model re-embeds papers on next use.
# EMBED_BASE_URL=https://api.tokenfactory.nebius.com/v1/
# EMBED_MODEL=Qwen/Qwen3-Embedding-8B
# EMBED_API_KEY=
# Embedding requests in flight at once, shared by score_candidates and the background warm-up.
# EMBED_CONCURRENCY=4

# --- Board service (client/) ------------------------------------------------------

# How the board service starts one harness per chat (split on spaces, no shell).
# HARNESS_CMD=uv run --project ../harness python -m harness
# Close a chat, and end its harness, after this many idle minutes.
# HARNESS_IDLE_MINUTES=10
# Refuse new chats (HTTP 503) above this many live harnesses.
# MAX_HARNESSES=8
